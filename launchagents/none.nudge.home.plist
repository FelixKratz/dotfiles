<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computers//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>none.nudge.home</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/nudge</string>
		<string>check</string>
		<string>home</string>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/.log/nudge-home.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.log/nudge-home.err</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
