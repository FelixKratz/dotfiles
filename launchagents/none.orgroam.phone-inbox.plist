<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computers//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>none.orgroam.phone-inbox</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/phone-inbox</string>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/.log/phone-inbox.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.log/phone-inbox.err</string>
	<key>WatchPaths</key>
	<array>
		<string>__HOME__/Library/Mobile Documents/com~apple~CloudDocs/Inbox</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
