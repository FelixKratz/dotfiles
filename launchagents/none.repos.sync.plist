<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computers//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>none.repos.sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/repo-sync</string>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/.log/repo-sync.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.log/repo-sync.err</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
