<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>none.hidutil.remap</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/hidutil-remap</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Reapplied on an interval because a keyboard that is unplugged and
	     reconnected comes back with no mapping at all. -->
	<key>StartInterval</key>
	<integer>60</integer>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
