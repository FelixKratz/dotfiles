#!/usr/bin/env bash
# org-roam-sync — commit local changes, rebase onto the remote, push.
# Cross-platform (Linux/macOS). Scheduled via cron (Linux) or launchd (macOS).
# Override the repo with ORG_ROAM_DIR / branch with ORG_ROAM_BRANCH.
set -uo pipefail

# Schedulers start with a minimal PATH; make sure git and friends are found.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

REPO="${ORG_ROAM_DIR:-$HOME/org-roam}"
BRANCH="${ORG_ROAM_BRANCH:-main}"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/org-roam-sync"
FAIL_FILE="$STATE_DIR/failures"
# Runs are 15 min apart, so this waits out an hour of network trouble before
# calling an unreachable remote a real outage.
FAIL_THRESHOLD=4

log() { echo "$(date '+%F %T') $*"; }

# Hand the condition to `nudge`, which surfaces it in the tmux bar and new
# shells and handles snoozing and notification. Keyed on the reason, so a
# different failure resurfaces something you snoozed.
stall() {
  local reason="$1"
  log "STALLED: $reason"
  command -v nudge >/dev/null 2>&1 &&
    nudge raise org-roam-sync -p 20 -k "$reason" "org-roam sync stalled: $reason"
}

unstall() {
  command -v nudge >/dev/null 2>&1 && nudge clear org-roam-sync
  return 0
}

# Network failures are usually a blip — count them and only stall once they
# persist, so a closed lid or a dropped VPN stays quiet.
transient_failure() {
  local reason="$1" count
  mkdir -p "$STATE_DIR"
  count=$(cat "$FAIL_FILE" 2>/dev/null)
  [[ "$count" =~ ^[0-9]+$ ]] || count=0
  count=$((count + 1))
  echo "$count" > "$FAIL_FILE"
  log "$reason (failure $count of $FAIL_THRESHOLD)"
  [ "$count" -ge "$FAIL_THRESHOLD" ] && stall "$reason ($count consecutive failures)"
  exit 1
}

cd "$REPO" 2>/dev/null || { log "repo not found: $REPO"; exit 1; }

# Single-instance lock: flock on Linux, mkdir fallback on macOS (no flock).
LOCK="${TMPDIR:-/tmp}/org-roam-sync.lock"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK"
  flock -n 9 || { log "another sync is running, skipping"; exit 0; }
else
  mkdir "$LOCK" 2>/dev/null || { log "another sync is running, skipping"; exit 0; }
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT
fi

# 1. Commit local changes (tracked and new files) if there are any.
if [ -n "$(git status --porcelain)" ]; then
  # vulpea maintains the :active: filetag from find-file-hook and
  # before-save-hook, so notes written by anything other than Emacs — an AI
  # session, a sync from another machine — can gain their first TODO and never
  # get tagged, leaving those tasks invisible to the agenda. Repair here, where
  # we already know something changed, so a quiet run costs nothing.
  if command -v org-roam-active-tags >/dev/null 2>&1; then
    ORG_ROAM_DIR="$REPO" org-roam-active-tags --fix >/dev/null 2>&1 \
      || log "active-tag repair failed"
  fi
  git add -A
  git commit -q -m "Auto-sync $(hostname -s) $(date '+%F %T')" && log "committed local changes"
fi

# 2. Rebase onto the remote; abort cleanly on conflict so the tree stays sane.
git fetch -q origin "$BRANCH" || transient_failure "cannot reach origin/$BRANCH"
if ! git rebase -q "origin/$BRANCH"; then
  git rebase --abort
  stall "conflict rebasing onto origin/$BRANCH — resolve by hand in $REPO"
  exit 1
fi

# 3. Push if we have unpushed commits.
if [ -n "$(git log "origin/$BRANCH..$BRANCH" --oneline 2>/dev/null)" ]; then
  git push -q origin "$BRANCH" || transient_failure "push to origin/$BRANCH failed"
  log "pushed"
fi

# A clean run clears whatever the last bad one left behind.
rm -f "$FAIL_FILE"
unstall
