#!/usr/bin/env bash
# tmux-desk — a tmux session, "desk", that keeps the review tools open: gh-dash
# for the PRs waiting on your review, and the bot's activity as it happens.
#
# It belongs on the machines you review from: a desktop (the profile lists
# `desktop`) that reaches the bot over ssh (~/.config/dotfiles/bot-host is
# set). Anywhere else it does nothing, so zshrc can run it unconditionally.
#
# Each tool runs in a loop and starts again when it exits, so quitting one is
# how to reload it after a config change. One that exits within a few seconds
# waits for Enter instead, so a failure (Touch ID declined, the bot machine
# unreachable) does not retry in a tight loop.
#
# Usage:
#   tmux-desk          create the session, or any of its windows that is
#                      missing or no longer running its tool, detached
#   tmux-desk attach   the same, then switch to the session (attach outside
#                      tmux)
#   tmux-desk run NAME the loop one window runs (prs or bot)
set -euo pipefail

SESSION=desk
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
# tmux starts window commands with the server's environment, which may predate
# zshrc's PATH.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
SELF="$HOME/.local/bin/tmux-desk"
[ -x "$SELF" ] || SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tmux-desk"

# Window names, in order, and what each runs. gh-dash goes through gh-me so it
# acts as you: gh's keyring holds only sbfnk-bot.
WINDOWS=(prs bot)
tool_of() {
  case "$1" in
    prs) echo "gh-me dash" ;;
    bot) echo "sbr watch" ;;
    *) return 1 ;;
  esac
}

front_line() {
  grep -qx 'desktop' "$CONFIG/profile" 2>/dev/null && [ -s "$CONFIG/bot-host" ]
}

run() {
  local tool start
  tool="$(tool_of "$1")" || { echo "tmux-desk: no window '$1'" >&2; exit 2; }
  while :; do
    start=$SECONDS
    $tool || true
    if (( SECONDS - start < 10 )); then
      read -rp "$tool exited straight away; press Enter to start it again " _
    fi
  done
}

# A window counts as running its tool only when its pane was started by this
# script: tmux-resurrect brings windows back as plain shells.
ensure() {
  local name target
  command -v tmux >/dev/null || return 0
  if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n "${WINDOWS[0]}" "$SELF run ${WINDOWS[0]}"
  fi
  for name in "${WINDOWS[@]}"; do
    target="=$SESSION:$name"
    if ! tmux list-windows -t "=$SESSION" -F '#{window_name}' | grep -qx "$name"; then
      tmux new-window -d -t "=$SESSION:" -n "$name" "$SELF run $name"
    elif [[ "$(tmux display-message -p -t "$target" '#{pane_start_command}')" \
      != *"tmux-desk run $name"* ]]; then
      tmux respawn-pane -k -t "$target" "$SELF run $name"
    fi
    tmux set-window-option -t "$target" automatic-rename off >/dev/null
  done
}

case "${1:-}" in
  "")
    front_line || exit 0
    ensure ;;
  attach)
    front_line || { echo "tmux-desk: not a machine you review from" >&2; exit 1; }
    ensure
    if [ -n "${TMUX:-}" ]; then
      tmux switch-client -t "=$SESSION"
    else
      exec tmux attach-session -t "=$SESSION"
    fi ;;
  run)
    run "${2:?tmux-desk run needs a window name}" ;;
  *)
    sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p;}' "$0" >&2
    exit 2 ;;
esac
