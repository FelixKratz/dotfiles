#!/bin/bash
# Queue management goes through the msmtpq wrapper to pick up its bash 3.2
# patch. Keep it verbose: in this mode msmtpq only reports failed or skipped
# sends through its log messages, which EMAIL_QUEUE_QUIET would hide.
export EMAIL_QUEUE_QUIET=
exec "$(dirname "$0")/msmtpq" --q-mgmt "$@"
