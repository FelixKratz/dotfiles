#!/bin/bash
# sbfnk-bot-review — look over what sbfnk-bot has done, and decide.
#
# sbfnk-bot-issues publishes nothing on its own. Each result waits in the
# review spool until you approve it here. Approvals and discards are carried
# out within two minutes; reruns and polish wait for any job in progress.
#
# Works on the machine the bot runs on, or anywhere else once that
# machine's ssh alias is the one line of ~/.config/dotfiles/bot-host.
#
# Usage:
#   sbfnk-bot-review                     list work waiting for a decision
#   sbfnk-bot-review show [ID]           the text, the screen's flags, the
#                                        commits and the files changed
#   sbfnk-bot-review diff [ID]           the full diff, in a pager
#                                        (also: show --diff [ID])
#   sbfnk-bot-review approve [ID]        publish: the draft PR, or the question;
#                                        for a request, let the bot take it on
#   sbfnk-bot-review approve --force [ID]
#                                        publish despite the screen's flags
#   sbfnk-bot-review approve --all       approve everything waiting that the
#                                        screen did not flag; lists the rest
#   sbfnk-bot-review answer [ID] [TEXT]  reply privately (TEXT, or stdin):
#                                        answer its question, or say what to
#                                        change in a PR; the bot runs again.
#                                        A line "bot-time: 3h" gives that run
#                                        more time
#   sbfnk-bot-review comment [ID] [TEXT] on an update to an open PR: post TEXT
#                                        (or stdin) on the PR, publicly and as
#                                        you, and drop the parked update; the
#                                        bot then answers your comment
#   sbfnk-bot-review push [ID]           push the bot's commits from your own
#                                        account, when they edit CI files its
#                                        token may not push; the bot then
#                                        publishes the rest
#   sbfnk-bot-review discard [ID]        drop the work
#   sbfnk-bot-review polish [ID] [TEXT]  edit, screen and fix its text again,
#                                        following TEXT if given; the work
#                                        itself is not redone
#   sbfnk-bot-review polish --strip-flagged [ID]
#                                        the same, removing what the screen
#                                        flagged
#   sbfnk-bot-review now                 what the bot is doing: the job, and
#                                        the latest steps of its session
#   sbfnk-bot-review log                 the bot's recent activity, why its
#                                        latest failed run failed, and what
#                                        the sandbox refused
#   sbfnk-bot-review pause               start nothing new; your decisions
#                                        still go out, a running job finishes
#   sbfnk-bot-review resume              carry on
#   sbfnk-bot-review accounts            the accounts the bot runs on, in the
#                                        order it tries them, and their limits
#   sbfnk-bot-review pause ACCOUNT       keep the bot off one account (to use
#                                        it yourself); it carries on with the
#                                        others, or waits if none has room
#   sbfnk-bot-review resume ACCOUNT      let it use that account again
#   sbfnk-bot-review watch               "now", then the bot's activity live,
#                                        without the skips; [1] and [2] are
#                                        the workers, [d] the decisions pass
#   sbfnk-bot-review count               how many wait (used by nudge)
#
# ID is the number list shows, or any unique prefix of the long id, and may
# be left out when only one item waits.

set -uo pipefail

SPOOL="${SBFNK_BOT_SPOOL:-/Users/Shared/sbfnk-bot}"
HOST_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/bot-host"

die() { echo "sbfnk-bot-review: $*" >&2; exit 1; }

# A decision changes what waits, so the menu-bar item and the nudge should
# not wait for their next timed check. The check runs here and now: an event
# can be dropped while sketchybar is still running an earlier check, and that
# earlier check started before this decision.
refresh_bar() {
  local plugin="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar/plugins/bot.sh"
  case "$1" in
    approve|force|answer|comment|push|discard|polish|pause|resume)
      [ -x "$plugin" ] && command -v sketchybar >/dev/null 2>&1 || return 0
      NAME=bot CONFIG_DIR="${plugin%/plugins/bot.sh}" "$plugin" \
        >/dev/null 2>&1 ;;
  esac
  return 0
}

# Help needs no spool, so it is answered here even away from the bot's host.
case "${1:-}" in
  -h|--help|help) awk 'NR > 1 && !/^#/ {exit} NR > 1' "$0"; exit 0 ;;
esac

# Not the bot's machine: run the same command there.
if [ ! -d "$SPOOL/pending" ] && [ -z "${SBFNK_BOT_REVIEW_HERE:-}" ]; then
  host="$(sed -e 's/#.*//' "$HOST_FILE" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$host" ] || die "no review spool here and no host in $HOST_FILE"
  args=""
  for a in "$@"; do args="$args $(printf '%q' "$a")"; done
  tty=()
  [ -t 0 ] && [ -t 1 ] && tty=(-t)
  ssh -q -o BatchMode=yes -o ConnectTimeout=5 "${tty[@]+"${tty[@]}"}" \
    "$host" "SBFNK_BOT_REVIEW_HERE=1 ~/.local/bin/sbfnk-bot-review$args"
  rc=$?
  if [ "$rc" -eq 255 ]; then
    # ssh's own failure, not the command's: say so rather than exit silently.
    echo "sbfnk-bot-review: cannot reach $host over ssh (away from its network?)." >&2
    echo "Review from anywhere with the desk: 'sbfnk-bot desk' in claude.ai/code or the Claude app." >&2
    exit 1
  fi
  refresh_bar "${1:-}"
  exit $rc
fi

PENDING="$SPOOL/pending"
DECISIONS="$SPOOL/decisions"

# Everything shown here was written by the bot. Control characters are
# dropped so its text cannot drive the terminal.
clean() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# Decisions for work that is no longer waiting have been carried out.
for f in "$DECISIONS"/*; do
  [ -f "$f" ] || continue
  [ -d "$PENDING/$(basename "$f")" ] || rm -f "$f"
done

# A decision the bot has not yet carried out. One it has, on work that stays
# parked (polish), is listed by mtime in the item's done file.
undecided() {
  local f="$DECISIONS/$1"
  [ -f "$f" ] || return 0
  grep -qx "$(stat -f %m "$f")" "$PENDING/$1/done" 2>/dev/null
}

waiting() {
  local d id
  for d in "$PENDING"/*/; do
    [ -f "$d/meta.json" ] || continue
    id="$(basename "$d")"
    # Work whose publication was given up on comes back for a decision.
    [ "${1:-}" = all ] || undecided "$id" || [ -f "$d/stuck" ] || continue
    echo "$id"
  done
}

# The one waiting item whose id starts with $1; any item will do for an
# empty $1, as long as there is only one.
resolve() {
  local matches="" id
  case "${1:-}" in
    [0-9]*)
      for id in $(waiting all); do
        [ "$(meta "$id" '.seq // empty')" = "$1" ] && matches="$id"
      done ;;
    *) matches="$(waiting all | awk -v p="${1:-}" 'index($0, p) == 1')" ;;
  esac
  case "$(printf '%s' "$matches" | grep -c .)" in
    0) die "nothing waiting matches '${1:-}'" ;;
    1) echo "$matches" ;;
    *) die "'${1:-}' matches more than one: $(printf '%s' "$matches" \
         | tr '\n' ' ')" ;;
  esac
}

decide() {
  local id="$1" verb="$2" text="${3:-}" tmp
  tmp="$(mktemp "$DECISIONS/.decision.XXXXXX")" || die "cannot write to $DECISIONS"
  printf '%s\n%s' "$verb" "$text" > "$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$DECISIONS/$id"
  case "$verb" in
    polish) echo "polish recorded for $id; it runs when no other job is running" ;;
    answer) echo "answer recorded for $id; the bot starts on it when no other job is running" ;;
    *) echo "$verb recorded for $id; carried out within two minutes" ;;
  esac
  refresh_bar "$verb"
}

meta() { jq -r "$2" "$PENDING/$1/meta.json"; }

# Where an item stands, for list: a decision on its way, what it needs from
# you, or the screen's flags.
state() {
  local d="$DECISIONS/$1" verb
  if [ -f "$d" ] && ! undecided "$1" \
    && { [ ! -f "$PENDING/$1/stuck" ] || [ "$d" -nt "$PENDING/$1/stuck" ]; }; then
    verb="$(head -1 "$d" | tr -d '[:space:]')"
    case "$verb" in
      polish|answer) echo "$verb recorded, waits for the bot's next job" ;;
      *) echo "$verb recorded, carried out within two minutes" ;;
    esac
  elif [ -f "$PENDING/$1/stuck" ] \
    && tail -1 "$PENDING/$1/publish-errors" 2>/dev/null | grep -qE 'was (merged|closed) before'; then
    echo "the PR was merged or closed meanwhile: sbr discard $(meta "$1" '.seq // empty')"
  elif [ -f "$PENDING/$1/stuck" ] && [ -s "$PENDING/$1/branch.bundle" ]; then
    echo "edits CI workflows: sbr push $(meta "$1" '.seq // empty')"
  elif [ -f "$PENDING/$1/stuck" ]; then
    echo "could not be published, see show"
  else
    echo "$(meta "$1" '.flags | length') flag(s)"
  fi
}

# The full commits and diff, paged when there is a terminal to page on.
show_diff() {
  [ -s "$PENDING/$1/diff.patch" ] || { echo "#$(meta "$1" '.seq // empty') has no diff"; return 0; }
  if [ -t 1 ]; then
    clean < "$PENDING/$1/diff.patch" | ${PAGER:-less}
  else
    clean < "$PENDING/$1/diff.patch"
  fi
}

# The log, line by line as it comes: control characters dropped as "clean"
# does (the bot wrote it), and in a terminal a colour per worker tag, with
# the line green for what went out, yellow for what waits on you, red for
# what failed. awk flushes each line; tr in a pipe would hold them back.
colour_log() {
  local tty=0
  [ -t 1 ] && tty=1
  LC_ALL=C awk -v e="$(printf '\033')" -v tty="$tty" '
    BEGIN {
      w["[1]"] = e "[36m"; w["[2]"] = e "[35m"; w["[3]"] = e "[34m"
      w["[d]"] = e "[90m"; r = e "[0m"
    }
    {
      line = $0
      gsub(/[\001-\010\013-\037\177]/, "", line)
      if (!tty) { print line; fflush(); next }
      if (line ~ /opened|pushed|no findings|: approved/) c = e "[32m"
      else if (line ~ /sbr push|parked|left for you|waits|waiting|usage limit/) c = e "[33m"
      else if (line ~ /fail|could not|refused|not published|missing|error/) c = e "[31m"
      else if (line ~ / poll |done$/) c = e "[2m"
      else c = ""
      if ($3 in w) { sub(/\[[0-9d]\]/, w[$3] $3 r (c ? c : ""), line) }
      print (c ? c : "") line r
      fflush()
    }'
}

# Said first wherever it matters: a paused bot starts nothing new.
paused_note() {
  local f
  for f in "$DECISIONS"/.paused.*; do
    [ -f "$f" ] && echo "account ${f##*/.paused.} paused since $(clean < "$f"): the bot keeps off it until sbr resume ${f##*/.paused.}"
  done
  [ -f "$DECISIONS/.paused" ] || return 0
  echo "PAUSED since $(cat "$DECISIONS/.paused" 2>/dev/null | clean): nothing new starts until sbr resume"
}

# The accounts as the bot last listed them, in the order it tries them.
show_accounts() {
  local a until now
  [ -s "$SPOOL/accounts" ] || die "the bot has not listed its accounts yet"
  now=$(date +%s)
  while IFS=$'\t' read -r a until; do
    printf '%-12s ' "$a"
    if [ -f "$DECISIONS/.paused.$a" ]; then
      echo "paused since $(clean < "$DECISIONS/.paused.$a")"
    elif [ -n "$until" ] && [ "$until" -gt "$now" ]; then
      echo "limited until $(date -r "$until" '+%a %H:%M')"
    else
      echo "has room"
    fi
  done < "$SPOOL/accounts"
}
known_account() {
  cut -f1 "$SPOOL/accounts" 2>/dev/null | grep -qxF "$1" \
    || die "no account '$1'; sbr accounts lists them"
}

# What each worker is on, from the status files the bot keeps per job.
show_now() {
  local f shown=false
  paused_note
  for f in "$SPOOL"/log/now/job*.txt; do
    [ -f "$f" ] || continue
    $shown && echo
    clean < "$f"
    shown=true
  done
  $shown || echo "the bot is idle"
}

cmd="${1:-list}"
[ $# -gt 0 ] && shift

case "$cmd" in
  list)
    paused_note
    ids="$(waiting)"
    # What the bot has stopped trying: nothing to decide here, but nothing
    # will happen without you either.
    given_up="$(cat "$SPOOL"/log/given-up/* 2>/dev/null | clean \
      | awk -F'\t' '{printf "     left alone: %s (%s, since %s): %s\n", $1, $2, $4, $3}')"
    if [ -z "$ids" ]; then
      echo "nothing waiting for review"
      [ -z "$given_up" ] || printf '%s\n' "$given_up"
      exit 0
    fi
    # By number, since numbers are reused and no longer follow the order
    # things were parked in.
    ids="$(for id in $ids; do
      printf '%s\t%s\n' "$(meta "$id" '.seq // 999')" "$id"
    done | sort -n | cut -f2)"
    for id in $ids; do
      # Unnumbered (a job stopped before it was numbered): the id addresses it.
      printf '#%-3s %s %s#%s: %s (%s)\n' \
        "$(meta "$id" ".seq // \"- $id\"")" "$(meta "$id" .outcome)" \
        "$(meta "$id" .repo)" "$(meta "$id" .number)" \
        "$(meta "$id" .title | clean)" \
        "$(state "$id")"
    done
    [ -z "$given_up" ] || printf '%s\n' "$given_up" ;;
  count)
    # grep -c exits 1 on a count of 0, which is an answer, not a failure.
    waiting | grep -c . || true ;;
  diff)
    id="$(resolve "${1:-}")" || exit 1
    show_diff "$id" ;;
  show)
    if [ "${1:-}" = --diff ]; then
      shift
      id="$(resolve "${1:-}")" || exit 1
      show_diff "$id"
      exit 0
    fi
    id="$(resolve "${1:-}")" || exit 1
    {
      printf '#%s %s %s#%s: %s\n' "$(meta "$id" '.seq // "-"')" \
        "$(meta "$id" .outcome)" "$(meta "$id" .repo)" \
        "$(meta "$id" .number)" "$(meta "$id" .title)"
      printf 'https://github.com/%s/%s/%s\n' "$(meta "$id" .repo)" \
        "$(if [ "$(meta "$id" .outcome)" = update ]; then echo pull; \
           else echo issues; fi)" "$(meta "$id" .number)"
      printf 'parked %s, cost $%s\n\n' "$(meta "$id" .created)" \
        "$(meta "$id" '.cost_usd // "?"')"
      if [ "$(meta "$id" '.fixed // [] | length')" -gt 0 ]; then
        echo "== removed before you saw it (the text below no longer has these) =="
        jq -r '.fixed[] | "- \(.reason)\n  was: \"\(.quote)\""' \
          "$PENDING/$id/meta.json"
        echo
      fi
      if [ "$(meta "$id" '.flags | length')" -gt 0 ]; then
        echo "== FLAGGED by the screen: read these before approving =="
        jq -r '.flags[] | "- \(.reason): \(.quote)"' "$PENDING/$id/meta.json"
        echo
      elif [ "$(meta "$id" .outcome)" != request ]; then
        echo "== the screen found nothing to flag =="
        echo
      fi
      if { [ "$(meta "$id" .outcome)" = pr ] \
           || [ "$(meta "$id" .outcome)" = update ]; } \
        && [ "$(meta "$id" '.edited // false')" != true ]; then
        echo "== not edited: the humanizer step did not run =="
        echo
      fi
      if [ -s "$PENDING/$id/publish-errors" ]; then
        echo "== could not be published (latest last) =="
        cat "$PENDING/$id/publish-errors"
        echo
      fi
      blocked="$(awk -F'\t' -v r="$(meta "$id" .repo)#$(meta "$id" .number)" \
        '$2 == r {print "- " $3}' "$SPOOL/log/blocked.tsv" 2>/dev/null | tail -10)"
      if [ -n "$blocked" ]; then
        echo "== refused by the sandbox on this issue (not published) =="
        printf '%s\n\n' "$blocked"
      fi
      echo "== text to publish =="
      cat "$PENDING/$id/text.md"
      if [ -s "$PENDING/$id/diff.patch" ]; then
        echo
        echo "== commits =="
        # Everything before the first file diff: each commit's message.
        awk '/^diff --git /{exit} {print}' "$PENDING/$id/diff.patch"
        echo "== files changed (sbr diff $(meta "$id" '.seq // empty') for the diff) =="
        awk '/^diff --git /{f=$3; sub(/^a\//, "", f); files[++n]=f}
             /^\+[^+]/{add[n]++} /^-[^-]/{del[n]++}
             END {for (i = 1; i <= n; i++)
                    printf "  %s  +%d -%d\n", files[i], add[i], del[i]}' \
          "$PENDING/$id/diff.patch"
      fi
    } | clean ;;
  approve)
    # Everything waiting and unflagged. Flagged work needs reading first, and
    # work stuck on a push or a discard needs that, so those are only listed.
    if [ "${1:-}" = --all ]; then
      n=0
      for id in $(waiting); do
        what="#$(meta "$id" '.seq // "-"') $(meta "$id" .repo)#$(meta "$id" .number)"
        if [ -f "$PENDING/$id/stuck" ]; then
          echo "skipped $what: $(state "$id")"
        elif [ "$(meta "$id" '.flags | length')" -gt 0 ]; then
          echo "skipped $what: flagged by the screen (sbr show, then approve --force)"
        else
          decide "$id" approve; n=$((n + 1))
        fi
      done
      echo "approved $n"
      exit 0
    fi
    force=false
    [ "${1:-}" = --force ] && { force=true; shift; }
    id="$(resolve "${1:-}")" || exit 1
    if [ "$(meta "$id" '.flags | length')" -gt 0 ] && ! $force; then
      die "the screen flagged $id; read 'show' and use approve --force if it is fine"
    fi
    if $force; then decide "$id" force; else decide "$id" approve; fi ;;
  answer)
    id="$(resolve "${1:-}")" || exit 1
    [ "$(meta "$id" .outcome)" != update ] \
      || die "#$(meta "$id" .seq) is an update to an open PR: answers are private, so use 'comment', which posts on the PR"
    shift 2>/dev/null
    text="$*"
    if [ -z "$text" ]; then
      [ -t 0 ] && echo "Type the answer, then Ctrl-D:" >&2
      text="$(cat)"
    fi
    [ -n "$text" ] || die "empty answer"
    decide "$id" answer "$text" ;;
  comment)
    id="$(resolve "${1:-}")" || exit 1
    [ "$(meta "$id" .outcome)" = update ] \
      || die "#$(meta "$id" .seq) is not an update to an open PR: use 'answer' to reply privately"
    shift 2>/dev/null
    text="$*"
    if [ -z "$text" ]; then
      [ -t 0 ] && echo "Type the comment (public, on the PR), then Ctrl-D:" >&2
      text="$(cat)"
    fi
    [ -n "$text" ] || die "empty comment"
    repo="$(meta "$id" .repo)"; n="$(meta "$id" .number)"
    # As sbfnk whichever gh account is active: the bot takes only his
    # comments as instructions.
    token="$(gh auth token -u sbfnk 2>/dev/null)" \
      || die "no gh login for sbfnk here (gh auth login)"
    url="$(GH_TOKEN="$token" gh pr comment "$n" -R "$repo" --body "$text")" \
      || die "could not comment on $repo#$n; the update stays parked"
    echo "commented: $url"
    # Dropping the update leaves your comment as the newest feedback, which
    # the bot answers on its next pass.
    decide "$id" discard ;;
  discard)
    id="$(resolve "${1:-}")" || exit 1
    decide "$id" discard ;;
  push)
    id="$(resolve "${1:-}")" || exit 1
    dir="$PENDING/$id"
    [ -s "$dir/branch.bundle" ] && [ -s "$dir/push-to" ] \
      || die "#$(meta "$id" .seq) has nothing for you to push"
    repo="$(meta "$id" .repo)"
    # A PR merged or closed since has nowhere to push to.
    if [ "$(meta "$id" .outcome)" = update ]; then
      state="$(gh api "repos/$repo/pulls/$(meta "$id" .number)" \
        --jq 'if .merged then "merged" else .state end' 2>/dev/null)"
      case "$state" in merged|closed)
        die "$repo#$(meta "$id" .number) was $state since: nothing to push to; sbr discard $(meta "$id" .seq)" ;;
      esac
    fi
    branch="$(sed -n 1p "$dir/push-to")"; from="$(sed -n 2p "$dir/push-to")"
    token="$(gh auth token -u sbfnk 2>/dev/null)" \
      || die "no gh login for sbfnk here (gh auth login)"
    url="https://github.com/$repo.git"
    # Your token in a header set through the environment, as the bot does.
    as_you() {
      LC_ALL=C GIT_CONFIG_COUNT=2 \
        GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0="" \
        GIT_CONFIG_KEY_1=http.https://github.com/.extraheader \
        GIT_CONFIG_VALUE_1="AUTHORIZATION: basic $(printf 'x-access-token:%s' \
          "$token" | openssl base64 -A)" \
        git "$@"
    }
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    git init -q "$tmp"
    # The bundle holds only the bot's commits; what they build on comes from
    # GitHub.
    as_you -C "$tmp" fetch -q "$url" "$from" \
      || die "could not fetch $from from $repo"
    git -C "$tmp" fetch -q "$dir/branch.bundle" HEAD \
      || die "the bundle does not apply to $repo's $from"
    sha="$(git -C "$tmp" rev-parse FETCH_HEAD)"
    echo "pushing ${sha:0:7} to $repo $branch"
    err="$(as_you -C "$tmp" push "$url" "${sha}:refs/heads/$branch" 2>&1)" || {
      printf '%s\n' "$err" | grep -E '^ ! |^(error|fatal):' >&2
      grep -q 'workflow' <<< "$err" \
        && echo "your sbfnk login lacks the workflow scope: with sbfnk active (gh auth switch -u sbfnk), run gh auth refresh -h github.com -s workflow" >&2
      die "push failed; nothing changed"
    }
    if [ "$(meta "$id" '.flags | length')" -gt 0 ]; then
      echo "pushed; the screen flagged it, so read 'show' and approve --force to publish the rest"
    else
      decide "$id" approve
    fi ;;
  polish)
    strip=false
    [ "${1:-}" = --strip-flagged ] && { strip=true; shift; }
    id="$(resolve "${1:-}")" || exit 1
    shift 2>/dev/null
    note="$*"
    if $strip; then
      [ "$(meta "$id" '.flags | length')" -gt 0 ] || die "#$(meta "$id" .seq) has no flags to strip"
      # The flagged passages, quoted, as the instruction for the edit.
      note="$(jq -r '"Remove each of these passages the screen flagged, and anything that only makes sense with them; keep everything else as it is:\n"
        + ([.flags[] | "- \"\(.quote)\""] | join("\n"))' "$PENDING/$id/meta.json")${note:+
$note}"
    fi
    decide "$id" polish "$note" ;;
  now) show_now ;;
  accounts) show_accounts ;;
  pause)
    if [ -n "${1:-}" ]; then
      known_account "$1"
      date '+%a %d %b %H:%M' > "$DECISIONS/.paused.$1" && chmod 644 "$DECISIONS/.paused.$1"
      echo "the bot keeps off the $1 account from its next run; a run already on it finishes"
    else
      date '+%a %d %b %H:%M' > "$DECISIONS/.paused" && chmod 644 "$DECISIONS/.paused"
      echo "paused: nothing new starts; your decisions still go out, and a job already running finishes"
    fi
    refresh_bar pause ;;
  resume)
    if [ -n "${1:-}" ]; then
      if [ -f "$DECISIONS/.paused.$1" ]; then
        rm -f "$DECISIONS/.paused.$1"
        echo "the bot uses the $1 account again from its next run"
      else
        echo "the $1 account is not paused"
      fi
    elif [ -f "$DECISIONS/.paused" ]; then
      rm -f "$DECISIONS/.paused"
      echo "resumed: new work starts from the next pass"
    else
      echo "not paused"
    fi
    refresh_bar resume ;;
  watch)
    show_now
    printf '\n== activity (Ctrl-C to stop) ==\n'
    tail -n 40 -F "$SPOOL/log/activity.log" 2>/dev/null \
      | grep --line-buffered -vE '^[^ ]+ [^ ]+ (\[[0-9d]\] )?  skip ' \
      | colour_log ;;
  log)
    tail -30 "$SPOOL/log/activity.log" 2>/dev/null | clean
    if [ -s "$SPOOL/log/blocked.tsv" ]; then
      printf '\n== refused by the sandbox (latest last) ==\n'
      tail -15 "$SPOOL/log/blocked.tsv" | awk -F'\t' '{print $1, $2 ": " $3}' | clean
    fi
    latest="$(ls -t "$SPOOL"/log/failures/*.txt 2>/dev/null | head -1)"
    if [ -n "$latest" ]; then
      printf '\n== latest failure: %s ==\n' "$(basename "$latest" .txt)"
      clean < "$latest"
    fi ;;
  *)
    die "unknown command '$cmd' (try --help)" ;;
esac
