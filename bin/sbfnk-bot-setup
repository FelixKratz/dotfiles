#!/bin/bash
# sbfnk-bot-setup — make this Mac the one that runs sbfnk-bot-issues.
#
# The bot runs as its own hidden, standard macOS account, so the operating
# system keeps it out of your home folder: notes, other repositories, Claude
# history and memory, mail. install:
#   - creates that account (sbfnkbot) and installs Claude Code for it
#   - closes your home folder to other accounts (chmod 700); macOS leaves it
#     readable by every local account otherwise
#   - installs the bot's script, allow-list, sandbox rules and a copy of your
#     humanizer skill in /opt/sbfnk-bot, where only root can change them
#   - creates the review spool in /Users/Shared/sbfnk-bot, where the bot
#     writes pending work and only you write decisions
#   - writes the LaunchDaemon that runs the bot every ten minutes, at low
#     priority so the machine's own work comes first
#
# Usage, from your own account (sudo drops ~/.local/bin from PATH, so give
# the full path; S=~/.local/bin/sbfnk-bot-setup below):
#   sudo $S install [--no-julia] the above, with juliaup unless --no-julia
#   sudo $S deps                 install the heavy shared dependencies once
#                                (rstan, cmdstan, testing and linting tools,
#                                JuliaFormatter, pre-commit), so runs do not
#                                spend their time on them
#   gh auth token -u sbfnk-bot | sudo $S gh-token
#   claude setup-token, then:  sudo $S claude-token   (paste the token)
#   sudo $S review-key           give the bot sbfnk-review-bot's private key,
#                                from ~/.config/sbfnk-review-bot/key.pem or stdin,
#                                so it can review PRs marked ready for review
#   sudo $S check                show the bot cannot read your files
#   sudo $S enable [--keep-running]
#                                start the daemons; --keep-running leaves a
#                                job in progress alone
#   sudo $S disable              stop it; everything else stays
#   $S desk                      (no sudo) a Remote Control session as you, for
#                                reviewing from claude.ai or the Claude app
#   $S desk-off                  (no sudo) stop it
#
# Run install again after pulling dotfiles, to update the installed copies.
# To move the bot to another machine: disable here, set it up there, and put
# that machine's ssh alias in ~/.config/dotfiles/bot-host where you review.

set -euo pipefail

BOT_USER=sbfnkbot
BOT_HOME=/Users/$BOT_USER
OPT=/opt/sbfnk-bot
SPOOL=/Users/Shared/sbfnk-bot
LABEL=none.bots.issues
PLIST=/Library/LaunchDaemons/$LABEL.plist
# Heavy jobs that may run side by side (see MAX_JOBS in sbfnk-bot-issues).
JOBS=3
DECISIONS_LABEL=none.bots.decisions
DECISIONS_PLIST=/Library/LaunchDaemons/$DECISIONS_LABEL.plist
SECRETS=$BOT_HOME/.config/sbfnk-bot

die() { echo "sbfnk-bot-setup: $*" >&2; exit 1; }
say() { echo "- $*"; }

case "${1:-}" in -h|--help|"") sed -n '2,33p' "$0"; exit 0 ;; esac
# The checkout this script lives in, through the ~/.local/bin symlink.
DOTFILES="$(dirname "$(dirname "$(perl -MCwd -e 'print Cwd::abs_path shift' "$0")")")"

# The desk: `claude remote-control` as you, in a folder whose CLAUDE.md and
# settings keep it to sbfnk-bot-review, and which asks before every decision.
# Spawned sessions run in default permission mode whatever your own default
# is, so text the bot wrote cannot get a decision recorded unseen. Its
# standard output is a terminal display redrawn continually, so it goes
# nowhere; errors still reach the log.
DESK_LABEL=none.bots.desk
desk() {
  local dir="$HOME/.local/share/sbfnk-bot-desk"
  local plist="$HOME/Library/LaunchAgents/$DESK_LABEL.plist"
  [ "$(id -u)" -ne 0 ] || die "run desk without sudo, as yourself"
  [ -x "$HOME/.local/bin/claude" ] || die "no claude in ~/.local/bin"
  mkdir -p "$dir/.claude" "$HOME/.log" "$(dirname "$plist")"
  cp "$DOTFILES/config/sbfnk-bot/desk/CLAUDE.md" "$dir/"
  cp "$DOTFILES/config/sbfnk-bot/desk/.claude/settings.json" "$dir/.claude/"
  cat > "$plist" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computers//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$DESK_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$HOME/.local/bin/claude</string>
		<string>remote-control</string>
		<string>--name</string>
		<string>sbfnk-bot desk</string>
		<string>--permission-mode</string>
		<string>default</string>
	</array>
	<key>WorkingDirectory</key>
	<string>$dir</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>$HOME/.log/sbfnk-bot-desk.err</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
PLISTEOF
  launchctl bootout "gui/$(id -u)/$DESK_LABEL" 2>/dev/null || true
  # bootout returns before the old session has exited, and bootstrap fails
  # while it is still there.
  local tries=0
  while launchctl print "gui/$(id -u)/$DESK_LABEL" >/dev/null 2>&1 \
    && [ "$tries" -lt 20 ]; do
    sleep 1; tries=$((tries + 1))
  done
  launchctl bootstrap "gui/$(id -u)" "$plist"
  say "desk running: open claude.ai/code or the Claude app and pick 'sbfnk-bot desk'"
}

case "${1:-}" in
  desk) desk; exit 0 ;;
  desk-off)
    launchctl bootout "gui/$(id -u)/$DESK_LABEL" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/$DESK_LABEL.plist"
    say "desk stopped"; exit 0 ;;
esac

[ "$(id -u)" -eq 0 ] || die "run with sudo"
OWNER="${SUDO_USER:-}"
[ -n "$OWNER" ] && [ "$OWNER" != root ] || die "run with sudo from your own account"
OWNER_HOME="$(dscl . -read "/Users/$OWNER" NFSHomeDirectory | awk '{print $2}')"

# From the bot's home: the caller's working directory is usually inside a
# home folder the bot cannot enter, and the installers need a readable one.
as_bot() { (cd "$BOT_HOME" && sudo -u "$BOT_USER" -H /bin/bash -c "$1"); }

store_secret() {
  local name="$1" value
  [ -t 0 ] && echo "Paste the $name, then Enter:" >&2
  IFS= read -r value || true
  value="$(printf '%s' "$value" | tr -d '[:space:]')"
  [ -n "$value" ] || die "no $name on stdin"
  install -d -o "$BOT_USER" -g staff -m 700 "$BOT_HOME/.config" "$SECRETS"
  ( umask 077; printf '%s\n' "$value" > "$SECRETS/$name" )
  chown "$BOT_USER:staff" "$SECRETS/$name"
  say "stored the $name for $BOT_USER"
}

# A LaunchDaemon running the bot as its own account, at low priority:
#   $1 plist path  $2 label  $3 interval in seconds  $4 extra argument
write_daemon() {
  local plist="$1" label="$2" interval="$3" arg="$4" argxml=""
  [ -n "$arg" ] && argxml="
		<string>$arg</string>"
  cat > "$plist" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computers//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$label</string>
	<key>UserName</key>
	<string>$BOT_USER</string>
	<key>GroupName</key>
	<string>staff</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>$OPT/sbfnk-bot-issues</string>$argxml
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>$BOT_HOME</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>$BOT_HOME</string>
	<key>StandardOutPath</key>
	<string>$SPOOL/log/$label.out</string>
	<key>StandardErrorPath</key>
	<string>$SPOOL/log/$label.err</string>
	<key>StartInterval</key>
	<integer>$interval</integer>
	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
PLISTEOF
  chown root:wheel "$plist"
  chmod 644 "$plist"
}

# Load a daemon afresh. bootout returns before a running job has exited, and
# bootstrap fails while it is still there; stopping it ends a run in progress.
restart_daemon() {
  local plist="$1" label="$2" tries=0
  launchctl bootout "system/$label" 2>/dev/null || true
  while launchctl print "system/$label" >/dev/null 2>&1 && [ "$tries" -lt 30 ]; do
    sleep 1; tries=$((tries + 1))
  done
  launchctl bootstrap system "$plist"
}

install_all() {
  # Julia comes as standard: the bot works on Julia repositories too. It is
  # a large download, so --no-julia skips it.
  local julia=true
  [ "${1:-}" = --no-julia ] && julia=false

  if ! dscl . -read "/Users/$BOT_USER" >/dev/null 2>&1; then
    sysadminctl -addUser "$BOT_USER" -fullName "sbfnk-bot" \
      -password "$(openssl rand -base64 30)" -home "$BOT_HOME" >/dev/null 2>&1
    createhomedir -c -u "$BOT_USER" >/dev/null
    dscl . -create "/Users/$BOT_USER" IsHidden 1
    say "created the hidden account $BOT_USER (it never needs to log in)"
  fi
  chmod 700 "$BOT_HOME"
  if [ "$(stat -f %Lp "$OWNER_HOME")" != 700 ]; then
    chmod 700 "$OWNER_HOME"
    say "closed $OWNER_HOME to other accounts (chmod 700)"
  fi

  install -d -o root -g wheel -m 755 "$OPT"
  install -o root -g wheel -m 755 "$DOTFILES/bin/sbfnk-bot-issues" "$OPT/"
  install -o root -g wheel -m 644 "$DOTFILES/config/sbfnk-bot/repos" \
    "$DOTFILES/config/sbfnk-bot/claude-settings.json" "$OPT/"
  if [ -r "$OWNER_HOME/.claude/skills/humanizer/SKILL.md" ]; then
    install -o root -g wheel -m 644 \
      "$OWNER_HOME/.claude/skills/humanizer/SKILL.md" "$OPT/humanizer.md"
  else
    say "no humanizer skill in $OWNER_HOME/.claude/skills; PR text goes unedited"
  fi
  say "installed the script, its rules and the humanizer in $OPT"

  install -d -o root -g wheel -m 755 "$SPOOL"
  install -d -o "$BOT_USER" -g staff -m 755 "$SPOOL/pending" "$SPOOL/log"
  install -d -o "$OWNER" -g staff -m 755 "$SPOOL/decisions"
  say "review spool in $SPOOL"

  if [ ! -x "$BOT_HOME/.local/bin/claude" ]; then
    say "installing Claude Code for $BOT_USER (a minute or two)"
    as_bot 'curl -fsSL https://claude.ai/install.sh | bash' >/dev/null
    say "installed Claude Code for $BOT_USER"
  fi
  # Build the toolchain's cache once outside the sandbox; runs also get
  # write access to it, so this only saves the first compile its lookup.
  as_bot 'xcrun --find clang' >/dev/null 2>&1 || true
  if command -v Rscript >/dev/null; then
    as_bot 'Rscript -e "dir.create(Sys.getenv(\"R_LIBS_USER\"), recursive = TRUE, showWarnings = FALSE)"' \
      >/dev/null 2>&1 || true
    # Without a mirror, R cannot install anything and falls back to building
    # from source; macOS binaries make a dependency a download rather than a
    # compile. Only a CRAN build of R can take those binaries, and a
    # Homebrew or self-built R refuses the option outright, so it is asked
    # for only where it applies.
    cat > "$BOT_HOME/.Rprofile" <<'RPROFILE'
local({
  opts <- list(repos = c(CRAN = "https://cloud.r-project.org"), Ncpus = 4L)
  if (.Platform$pkgType != "source") {
    opts$pkgType <- "both"
    opts$install.packages.check.source <- "no"
    opts$install.packages.compile.from.source <- "never"
  }
  options(opts)
})
RPROFILE
    chown "$BOT_USER:staff" "$BOT_HOME/.Rprofile"
    if [ "$(as_bot 'Rscript -e "cat(.Platform\$pkgType)"' 2>/dev/null)" \
      = source ]; then
      say "wrote $BOT_HOME/.Rprofile (CRAN mirror; this R builds from source)"
    else
      say "wrote $BOT_HOME/.Rprofile (CRAN mirror, binary packages)"
    fi
  fi
  if $julia && [ ! -x "$BOT_HOME/.juliaup/bin/julia" ]; then
    as_bot 'curl -fsSL https://install.julialang.org | sh -s -- --yes' >/dev/null
    say "installed juliaup for $BOT_USER"
  fi

  # launchd runs one copy of a job, so each concurrent job slot is a daemon of
  # its own; the script decides whether there is room for it.
  write_daemon "$PLIST" "$LABEL" 600 ""
  for i in $(seq 2 "$JOBS"); do
    write_daemon "/Library/LaunchDaemons/$LABEL$i.plist" "$LABEL$i" 600 ""
  done
  for f in /Library/LaunchDaemons/"$LABEL"[0-9]*.plist; do
    [ -f "$f" ] || continue
    i="$(basename "$f" .plist)"; i="${i#"$LABEL"}"
    [ "$i" -le "$JOBS" ] && continue
    launchctl bootout "system/$LABEL$i" 2>/dev/null || true
    rm -f "$f"
  done
  write_daemon "$DECISIONS_PLIST" "$DECISIONS_LABEL" 120 --decisions
  say "wrote $PLIST and $DECISIONS_PLIST (not started)"

  for s in gh-token claude-token; do
    [ -s "$SECRETS/$s" ] || say "still needed: the $s (see --help)"
  done
  say "then: sudo $0 check, and sudo $0 enable"
}

# Each line should say "no": the bot account reading or writing where it
# must not.
check() {
  local path
  for path in "$OWNER_HOME" "$OWNER_HOME/org-roam" "$OWNER_HOME/code" \
    "$OWNER_HOME/.claude"; do
    if as_bot "ls '$path'" >/dev/null 2>&1; then
      echo "READABLE by $BOT_USER: $path"
    else
      echo "no: $BOT_USER cannot read $path"
    fi
  done
  for path in "$OPT/sbfnk-bot-issues" "$OPT/repos" "$SPOOL/decisions/probe"; do
    if as_bot "touch '$path'" >/dev/null 2>&1; then
      echo "WRITABLE by $BOT_USER: $path"
    else
      echo "no: $BOT_USER cannot write $path"
    fi
  done
  # The startup disk appears here as a symlink to /; only real mounts count.
  for path in /Volumes/*; do
    [ -e "$path" ] && [ ! -L "$path" ] || continue
    as_bot "ls '$path'" >/dev/null 2>&1 \
      && echo "note: $path is readable by $BOT_USER; the sandbox rules deny it"
  done
  return 0
}

case "${1:-}" in
  install) install_all "${2:-}" ;;
  gh-token) store_secret gh-token ;;
  review-key)
    key="$OWNER_HOME/.config/sbfnk-review-bot/key.pem"
    install -d -o "$BOT_USER" -g staff -m 700 "$BOT_HOME/.config" "$SECRETS"
    if [ -t 0 ] && [ -r "$key" ]; then
      install -o "$BOT_USER" -g staff -m 600 "$key" "$SECRETS/review-key.pem"
    elif [ ! -t 0 ]; then
      ( umask 077; cat > "$SECRETS/review-key.pem" )
      chown "$BOT_USER:staff" "$SECRETS/review-key.pem"
    else
      die "no key at $key; pipe it in instead"
    fi
    grep -q 'PRIVATE KEY' "$SECRETS/review-key.pem" || die "that is not a private key"
    say "stored sbfnk-review-bot's key for $BOT_USER" ;;
  claude-token) store_secret claude-token ;;
  check) check ;;
  deps)
    say "installing shared dependencies as $BOT_USER; this takes a while"
    as_bot 'Rscript -e "install.packages(c(\"devtools\", \"testthat\", \"lintr\", \"roxygen2\", \"rstan\", \"rstantools\", \"cmdstanr\", \"data.table\", \"posterior\"), repos = c(CRAN = \"https://cloud.r-project.org\", \"https://stan-dev.r-universe.dev\"))"' \
      2>&1 | tail -3
    as_bot 'Rscript -e "v <- tryCatch(cmdstanr::cmdstan_version(error_on_NA = FALSE), error = function(e) NULL); if (is.null(v)) cmdstanr::install_cmdstan(cores = 4) else cat(\"cmdstan\", v, \"already installed\n\")"' \
      2>&1 | tail -3
    if [ -x "$BOT_HOME/.juliaup/bin/julia" ]; then
      # Julia keeps a package's precompiled cache under ~/.julia/compiled by
      # version, and every project using that version reads it, so warming
      # the heavy ones here spares each run ten minutes of cold precompiling.
      as_bot "$BOT_HOME/.juliaup/bin/julia --startup-file=no -e 'using Pkg; Pkg.activate(\"tools\"; shared = true); Pkg.add([\"JuliaFormatter\", \"Documenter\", \"Aqua\", \"Turing\", \"Distributions\", \"ForwardDiff\", \"Mooncake\", \"DifferentiationInterface\", \"DifferentiationInterfaceTest\", \"DataFrames\", \"BenchmarkTools\"]); Pkg.precompile()'" \
        2>&1 | tail -2
    fi
    if command -v pipx >/dev/null; then
      as_bot 'pipx install pre-commit' 2>&1 | tail -2
    fi
    say "done; a run installs anything else it needs by itself" ;;
  enable)
    for s in gh-token claude-token; do
      [ -s "$SECRETS/$s" ] || die "no $s yet (see --help)"
    done
    [ -f "$PLIST" ] && [ -f "$DECISIONS_PLIST" ] || die "run install first"
    # The light pass first: restarting it never interrupts real work.
    restart_daemon "$DECISIONS_PLIST" "$DECISIONS_LABEL"
    for i in "" $(seq 2 "$JOBS"); do
      p="/Library/LaunchDaemons/$LABEL$i.plist"
      [ -f "$p" ] || continue
      if [ "${2:-}" = --keep-running ] \
        && launchctl print "system/$LABEL$i" 2>/dev/null | grep -q 'state = running'; then
        say "left $LABEL$i running; it picks up the new copy at its next start"
      else
        restart_daemon "$p" "$LABEL$i"
      fi
    done
    say "started; heavy work polls every ten minutes, decisions every two" ;;
  disable)
    for l in "$DECISIONS_LABEL" "$LABEL" $(for i in $(seq 2 "$JOBS"); do echo "$LABEL$i"; done); do
      if launchctl bootout "system/$l" 2>/dev/null; then
        say "stopped $l"
      else
        say "$l was not running"
      fi
    done ;;
  *) die "unknown command '$1' (try --help)" ;;
esac
