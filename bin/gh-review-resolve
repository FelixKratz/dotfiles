#!/usr/bin/env bash
# Resolve a PR review thread.
#
# This runs as the plain authenticated account, not as sbfnk-review-bot[bot].
# Closing a finding is conceptually the reviewer's call, but GitHub Apps cannot
# call `resolveReviewThread`: the installation holds `pull_requests: write` and
# `checks: write` (check with `gh-review-bot-token --permissions <owner>/<repo>`)
# and the mutation still returns "Resource not accessible by integration". There
# is no permission to grant, so the author resolves and the reply above records
# who actually found the problem.
#
# Thread ids come from the reviewThreads GraphQL query; the REST comments
# endpoint does not expose them:
#
#   gh api graphql -f query='query($o:String!,$r:String!,$n:Int!){
#     repository(owner:$o,name:$r){pullRequest(number:$n){
#       reviewThreads(first:100){nodes{id isResolved isOutdated
#         comments(first:1){nodes{path body}}}}}}}' \
#     -f o=<owner> -f r=<repo> -F n=<pr>
#
# The mutation is hardcoded, so this cannot write anything else.
#
# Usage:
#   gh-review-resolve <thread-id>
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <thread-id>" >&2
  exit 64
fi
thread=$1

gh api graphql \
  -f query='mutation($id:ID!){resolveReviewThread(input:{threadId:$id}){thread{isResolved}}}' \
  -f id="$thread" --jq '"resolved: \(.data.resolveReviewThread.thread.isResolved)"'
