# Opened at startup on the machines you review from (see bin/review-desk):
# a shell, then gh-dash and the bot's activity in tabs of their own.
new_tab
launch
focus

new_tab prs
launch --title prs sh -c 'exec "$HOME/.local/bin/review-desk" run prs'

new_tab bot
launch --title bot sh -c 'exec "$HOME/.local/bin/review-desk" run bot'
