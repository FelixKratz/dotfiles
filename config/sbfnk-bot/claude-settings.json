{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "cloud.r-project.org",
        "cran.r-project.org",
        "*.r-universe.dev",
        "r-universe.dev",
        "p3m.dev",
        "packagemanager.posit.co",
        "julialang.org",
        "*.julialang.org",
        "pypi.org",
        "files.pythonhosted.org",
        "zenodo.org",
        "*.zenodo.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/R",
        "~/.julia",
        "~/.cache/R",
        "~/Library/Caches"
      ],
      "denyRead": [
        "~/.config/sbfnk-bot",
        "~/.local/share/sbfnk-bot-issues",
        "~/.ssh",
        "~/.config/gh",
        "/Users/Shared",
        "/Volumes"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:cran.r-project.org)",
      "WebFetch(domain:search.r-project.org)",
      "WebFetch(domain:r-universe.dev)",
      "WebFetch(domain:*.r-universe.dev)",
      "WebFetch(domain:rdrr.io)",
      "WebFetch(domain:docs.julialang.org)",
      "WebFetch(domain:pkgdocs.julialang.org)",
      "WebFetch(domain:juliahub.com)",
      "WebFetch(domain:mc-stan.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:zenodo.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:*.github.io)",
      "WebFetch(domain:*.epinowcast.org)",
      "WebFetch(domain:*.epiforecasts.io)",
      "WebFetch(domain:en.wikipedia.org)"
    ],
    "deny": [
      "Read(~/.config/sbfnk-bot/**)",
      "Read(~/.local/share/sbfnk-bot-issues/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(//Users/Shared/**)",
      "Read(//Volumes/**)"
    ]
  }
}
