{
  "name": "dotfiles-lsp",
  "owner": {
    "name": "Sebastian Funk"
  },
  "plugins": [
    {
      "name": "r-lsp",
      "description": "R language server (languageserver) for code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "Sebastian Funk"
      },
      "source": "./r-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "r-languageserver": {
          "command": "R",
          "args": [
            "--no-echo",
            "--no-restore",
            "-e",
            "languageserver::run()"
          ],
          "extensionToLanguage": {
            ".R": "r",
            ".r": "r",
            ".Rmd": "r",
            ".qmd": "r"
          }
        }
      }
    },
    {
      "name": "julia-lsp",
      "description": "Julia language server (LanguageServer.jl) for code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "Sebastian Funk"
      },
      "source": "./julia-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "julia-languageserver": {
          "command": "julia",
          "args": [
            "--startup-file=no",
            "--history-file=no",
            "--project=@v#.#",
            "-e",
            "using LanguageServer; runserver()"
          ],
          "extensionToLanguage": {
            ".jl": "julia"
          }
        }
      }
    },
    {
      "name": "julia-repl",
      "description": "Warm Julia session (AgentREPL) over MCP, started only inside Julia projects",
      "version": "1.0.0",
      "author": {
        "name": "Sebastian Funk"
      },
      "source": "./julia-repl",
      "category": "development",
      "strict": false,
      "mcpServers": {
        "julia-repl": {
          "command": "${CLAUDE_PLUGIN_ROOT}/bin/julia-repl-server",
          "env": {
            "JULIA_REPL_HIGHLIGHT": "false",
            "JULIA_REPL_OUTPUT_FORMAT": "plain"
          }
        }
      }
    },
    {
      "name": "pr-followup",
      "description": "After gh pr create, start /wait-for-review on the new pull request",
      "version": "1.0.0",
      "author": {
        "name": "Sebastian Funk"
      },
      "source": "./pr-followup",
      "category": "development",
      "strict": false,
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/bin/after-pr-create"
              }
            ]
          }
        ]
      }
    }
  ]
}
